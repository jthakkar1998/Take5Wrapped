sqlite3 -header -column ~/Desktop/Take5Export/chat.db <<'SQL'
SELECT
    c.ROWID AS chat_id,
    COUNT(DISTINCT m.ROWID) AS messages,
    (SELECT COUNT(DISTINCT handle_id)
     FROM chat_handle_join
     WHERE chat_id = c.ROWID) AS other_handles,
    DATE(MIN(m.date) / 1000000000.0 + 978307200,
         'unixepoch', 'localtime') AS first_message,
    DATE(MAX(m.date) / 1000000000.0 + 978307200,
         'unixepoch', 'localtime') AS last_message
FROM chat c
LEFT JOIN chat_message_join cmj ON c.ROWID = cmj.chat_id
LEFT JOIN message m ON cmj.message_id = m.ROWID
WHERE c.ROWID IN (1696, 1700, 1731)
GROUP BY c.ROWID
ORDER BY c.ROWID;
SQL
